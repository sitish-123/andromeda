[Unit]
Description=Portal backend (andromeda)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.andromeda
ExecStart=@libexecdir@/xdg-desktop-portal-andromeda
Restart=on-failure
RestartSec=5s
# The LP-E cores' slice, with the desktop's other background daemons (docs/power.md, program step 7).
Slice=background.slice
