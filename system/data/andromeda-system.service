[Unit]
Description=Andromeda system state and policy (org.andromeda.System1)
Documentation=https://github.com/Andromeda-Desktop/desktop/blob/main/docs/system-health.md
After=dbus.service

[Service]
Type=notify
ExecStart=/usr/lib/andromeda/andromeda-system
Restart=on-failure
WatchdogSec=30s
# Root only for reads the kernel keeps from users (RAPL energy_uj 0400); PSI triggers with 1 s windows need
# CAP_SYS_RESOURCE. CAP_NET_ADMIN creates the hotspot AP interface (nl80211 add interface).
# CAP_SYS_ADMIN, CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH (stack files are 0400, owned by the task's user): /proc/<pid>/stack
# for Diagnostics.KernelStacks.
CapabilityBoundingSet=CAP_SYS_RESOURCE CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=andromeda-system
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=64M

[Install]
WantedBy=multi-user.target
