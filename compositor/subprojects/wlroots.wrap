[wrap-git]
url = https://gitlab.freedesktop.org/wlroots/wlroots.git
revision = 0.20.2
depth = 1
# Skips the cursor plane in an atomic commit when the cursor did not change (upstream re-arms it each frame).
# Skips layer feedback for planes another CRTC still holds at startup (no liftoff handle; upstream reads NULL).
# Registers the planes a previous master left on a CRTC at its first commit, not only on a modeset (no modeset at login).
# Resets IN_FENCE_FD to -1 on frames without a fence (the last fd is closed; every allocation failed with EINVAL, no plane).
# Fails a test that leaves a layer or the primary buffer without a plane. libliftoff links into the private libwlroots,
# so the compositor's liftoff_* interposer (src/server/liftoff_deadline.cpp) never runs in the package.
# Logs no error when closing an input device the kernel removed: logind already released it ("Device not taken").
diff_files = wlroots-cursor-plane-unchanged.patch, wlroots-feedback-unregistered-plane.patch, wlroots-register-planes-without-modeset.patch, wlroots-libliftoff-clear-in-fence.patch, wlroots-libliftoff-test-unshown-layer.patch, wlroots-session-close-removed-device.patch

[provide]
dependency_names = wlroots-0.20
