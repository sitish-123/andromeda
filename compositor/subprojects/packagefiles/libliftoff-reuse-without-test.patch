+/* Since the last apply only buffers changed (FB_ID with the same FB info,
+ * IN_FENCE_FD, FB_DAMAGE_CLIPS): the plane layout the kernel accepted for the
+ * last real commit holds for this one too. */
+static bool
+output_flip_only(struct liftoff_output *output)
+{
+	struct liftoff_layer *layer;
+	struct liftoff_layer_property *prop;
+	size_t i;
+
+	liftoff_list_for_each(layer, &output->layers, link) {
+		for (i = 0; i < layer->props_len; i++) {
+			prop = &layer->props[i];
+			if (prop->value == prop->prev_value ||
+			    prop->core_index == LIFTOFF_PROP_FB_ID ||
+			    strcmp(prop->name, "IN_FENCE_FD") == 0 ||
+			    strcmp(prop->name, "FB_DAMAGE_CLIPS") == 0) {
+				continue;
+			}
+			return false;
+		}
+	}
+	return true;
+}
