+/* The plane already shows this layer as committed: the kernel keeps a plane
+ * that is not in the request, and adding it would re-arm the plane. */
+static bool
+plane_unchanged(struct liftoff_plane *plane, uint32_t flags)
+{
+	struct liftoff_layer *layer = plane->layer;
+	size_t i;
+
+	if (flags & DRM_MODE_ATOMIC_ALLOW_MODESET) {
+		return false;
+	}
+	/* An unused plane that is already off: adding it again ties the
+	 * request to the plane's previous commit, which the kernel may not
+	 * have completed yet when the page-flip event arrives (EBUSY). */
+	if (layer == NULL) {
+		return plane->committed_disabled;
+	}
+	if (layer->committed_plane != plane) {
+		return false;
+	}
+	for (i = 0; i < layer->props_len; i++) {
+		if (layer->props[i].value != layer->props[i].committed_value) {
+			return false;
+		}
+	}
+	return true;
+}
+
+void
+liftoff_output_mark_committed(struct liftoff_output *output)
+{
+	struct liftoff_layer *layer;
+	struct liftoff_plane *plane;
+	size_t i;
+
+	liftoff_list_for_each(layer, &output->layers, link) {
+		layer->committed_plane = NULL;
+	}
+	liftoff_list_for_each(plane, &output->device->planes, link) {
+		layer = plane->layer;
+		plane->committed_disabled = layer == NULL;
+		if (layer == NULL || layer->output != output) {
+			continue;
+		}
+		layer->committed_plane = plane;
+		for (i = 0; i < layer->props_len; i++) {
+			layer->props[i].committed_value = layer->props[i].value;
+		}
+	}
+}
