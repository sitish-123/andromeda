 	return 0;
 }
 
+/* The plane already shows this layer as committed: the kernel keeps a plane
+ * that is not in the request, and adding it would re-arm the plane. */
+static bool
+plane_unchanged(struct liftoff_plane *plane, uint32_t flags)
+{
+	struct liftoff_layer *layer = plane->layer;
+	size_t i;
+
+	if ((flags & DRM_MODE_ATOMIC_ALLOW_MODESET) || layer == NULL ||
+	    layer->committed_plane != plane) {
+		return false;
+	}
+	for (i = 0; i < layer->props_len; i++) {
+		if (layer->props[i].value != layer->props[i].committed_value) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+mark_committed(struct liftoff_device *device, struct liftoff_output *output,
+	       uint32_t flags)
+{
+	struct liftoff_layer *layer;
+	struct liftoff_plane *plane;
+	size_t i;
+
+	if (flags & DRM_MODE_ATOMIC_TEST_ONLY) {
+		return;
+	}
+	liftoff_list_for_each(layer, &output->layers, link) {
+		layer->committed_plane = NULL;
+	}
+	liftoff_list_for_each(plane, &device->planes, link) {
+		layer = plane->layer;
+		if (layer == NULL) {
+			continue;
+		}
+		layer->committed_plane = plane;
+		for (i = 0; i < layer->props_len; i++) {
+			layer->props[i].committed_value = layer->props[i].value;
+		}
+	}
+}
+
 static int
-apply_current(struct liftoff_device *device, drmModeAtomicReq *req)
+apply_current(struct liftoff_device *device, drmModeAtomicReq *req,
+	      uint32_t flags)
 {
