 	int cursor, ret;
@@ -574,6 +621,9 @@ apply_current(struct liftoff_device *device, drmModeAtomicReq *req)
 	cursor = drmModeAtomicGetCursor(req);
 
 	liftoff_list_for_each(plane, &device->planes, link) {
+		if (plane_unchanged(plane, flags)) {
+			continue;
+		}
 		ret = plane_apply(plane, plane->layer, req);
 		if (ret != 0) {
 			drmModeAtomicSetCursor(req, cursor);
@@ -843,7 +893,7 @@ reuse_previous_alloc(struct liftoff_output *output, drmModeAtomicReq *req,
 
 	cursor = drmModeAtomicGetCursor(req);
 
-	ret = apply_current(device, req);
+	ret = apply_current(device, req, flags);
 	if (ret != 0) {
 		return ret;
 	}
@@ -975,6 +1025,7 @@ liftoff_output_apply(struct liftoff_output *output, drmModeAtomicReq *req,
 	if (ret == 0) {
 		log_reuse(output);
 		mark_layers_clean(output);
+		mark_committed(device, output, flags);
 		return 0;
 	}
 	log_no_reuse(output);
@@ -1085,7 +1136,7 @@ liftoff_output_apply(struct liftoff_output *output, drmModeAtomicReq *req,
 		liftoff_log(LIFTOFF_DEBUG, "  (No layer has a plane)");
 	}
 
-	ret = apply_current(device, req);
