[Desktop Entry]
Type=Application
Name=Settings
GenericName=System Settings
Comment=Displays, sound, network, appearance, and every desktop setting
# The fallback starts the whole shell (idle, power and session logic): only in an Andromeda session, never inside another desktop.
Exec=sh -c "andromeda-shell msg settings-open || case :\\$XDG_CURRENT_DESKTOP: in *:andromeda:*) andromeda-shell --daemon && andromeda-shell msg settings-open ;; *) exit 1 ;; esac"
Icon=dev.noctalia.Settings
Terminal=false
Categories=System;Settings;DesktopSettings;
StartupNotify=false
StartupWMClass=dev.noctalia.Noctalia
Keywords=settings;preferences;system;display;network;sound;appearance;power;users;andromeda;
