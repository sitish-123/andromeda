-/// GDM-style hand-off over `/run/user/<uid>/greetd-handoff.sock`, one request line per connection. The incoming
-/// compositor sends `switch` once it holds the DRM device (inactive session) and greetd activates `vt`: logind then
-/// pauses the outgoing session's devices and resumes the incoming ones in one step, so the kernel never gets a moment
-/// without a DRM master to restore its console. After its first frame the compositor sends `ready` and `outgoing`
-/// gets SIGTERM. A connection that closes without a line is `ready` from a compositor that predates `switch`.
-/// Without `switch` greetd switches after 3 s; without `ready` the alarm fallback retires `outgoing` after 10 s.
-/// With `logout`, the socket stays for the whole session: its `logout` request starts the logout hand-off.
-fn retire_on_ready(
-    user: &str,
-    vt: Option<usize>,
-    outgoing: nix::unistd::Pid,
-    logout: Option<mpsc::UnboundedSender<()>>,
-) {
-    let Ok(Some(account)) = nix::unistd::User::from_name(user) else {
-        if let Some(vt) = vt {
-            tokio::task::spawn_local(activate_vt(vt));
-        }
-        return;
-    };
-    let path = format!("/run/user/{}/greetd-handoff.sock", account.uid);
+/// The hand-off socket of a user; greetd owns the directory, so it exists before the user's runtime dir does.
+fn handoff_path(uid: nix::unistd::Uid) -> String {
+    format!("/run/greetd-handoff/{uid}.sock")
+}
+
+/// Binds the user's hand-off socket before the session starts, so its compositor never misses it.
+fn bind_handoff(user: &str) -> Option<(tokio::net::UnixListener, String)> {
+    let account = nix::unistd::User::from_name(user).ok().flatten()?;
+    if let Err(e) = std::fs::create_dir_all("/run/greetd-handoff") {
+        eprintln!("hand-off: unable to create /run/greetd-handoff: {e}");
+        return None;
+    }
+    let path = handoff_path(account.uid);
     let _ = std::fs::remove_file(&path);
     let listener = match tokio::net::UnixListener::bind(&path) {
         Ok(listener) => listener,
         Err(e) => {
             eprintln!("hand-off: unable to listen on {path}: {e}");
-            if let Some(vt) = vt {
-                tokio::task::spawn_local(activate_vt(vt));
-            }
-            return;
+            return None;
         }
     };
     if let Err(e) = nix::unistd::chown(path.as_str(), Some(account.uid), Some(account.gid)) {
         eprintln!("hand-off: unable to chown {path}: {e}");
     }
+    Some((listener, path))
+}
+
+/// GDM-style hand-off over `/run/greetd-handoff/<uid>.sock`, one request line per connection. The incoming
+/// compositor sends `switch` once it holds the DRM device (inactive session) and greetd activates `vt`: logind then
+/// pauses the outgoing session's devices and resumes the incoming ones in one step, so the kernel never gets a moment
+/// without a DRM master to restore its console. After its first frame the compositor sends `ready` and `outgoing`
+/// gets SIGTERM. A connection that closes without a line is `ready` from a compositor that predates `switch`.
+/// Without `switch` greetd switches after 8 s; without `ready` the alarm fallback retires an outgoing greeter after 15 s.
+/// With `logout`, the socket stays for the whole session: its `logout` request starts the logout hand-off.
+fn serve_handoff(
+    socket: Option<(tokio::net::UnixListener, String)>,
+    vt: Option<usize>,
+    outgoing: Option<nix::unistd::Pid>,
+    logout: Option<mpsc::UnboundedSender<()>>,
+) -> tokio::task::AbortHandle {
+    let Some((listener, path)) = socket else {
+        return tokio::task::spawn_local(async move {
+            if let Some(vt) = vt {
+                activate_vt(vt).await;
+            }
+        })
+        .abort_handle();
+    };
     tokio::task::spawn_local(async move {
         use tokio::io::AsyncBufReadExt;
         use tokio::time::{timeout, timeout_at, Instant};
         let start = Instant::now();
-        let switch_deadline = start + Duration::from_secs(3);
-        let ready_deadline = start + Duration::from_secs(10);
+        let switch_deadline = start + Duration::from_secs(8);
+        let ready_deadline = start + Duration::from_secs(15);
         let mut pending_vt = vt;
         let mut retired = false;
         'accept: loop {
@@ -647,7 +708,7 @@ fn retire_on_ready(
                 }
                 Err(_) => {
                     if let Some(vt) = pending_vt.take() {
-                        eprintln!("hand-off: no switch request in 3 s, switching to VT {vt}");
+                        eprintln!("hand-off: no switch request in 8 s, switching to VT {vt}");
                         activate_vt(vt).await;
                     } else {
                         // The alarm fallback retires the outgoing session.
@@ -677,7 +738,9 @@ fn retire_on_ready(
                         }
                         if !retired {
                             retired = true;
-                            let _ = nix::sys::signal::kill(outgoing, nix::sys::signal::Signal::SIGTERM);
+                            if let Some(outgoing) = outgoing {
+                                let _ = nix::sys::signal::kill(outgoing, nix::sys::signal::Signal::SIGTERM);
+                            }
                         }
                     }
                     "logout" if retired => {
@@ -694,7 +757,8 @@ fn retire_on_ready(
             activate_vt(vt).await;
         }
         let _ = std::fs::remove_file(&path);
-    });
+    })
+    .abort_handle()
 }
 
 /// Activates `vt` and waits until it is in front; VT_WAITACTIVE blocks, so it runs off the event loop. Plain
