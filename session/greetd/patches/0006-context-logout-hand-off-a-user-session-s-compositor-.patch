-/// GDM-style hand-off over `/run/user/<uid>/greetd-handoff.sock`. The session compositor sends `switch` once it holds
-/// the DRM device (inactive session) and greetd activates the session's VT: logind then pauses the greeter's devices
-/// and resumes the compositor's in one step, so the kernel never gets a moment without a DRM master to restore its
-/// console. After its first frame the compositor sends `ready` and the greeter session gets SIGTERM. A connection that
-/// closes without a line is `ready` from a compositor that predates `switch`. Without `switch` greetd switches after
-/// 3 s; without `ready` the alarm fallback retires the greeter after 10 s.
-fn retire_on_ready(user: &str, vt: Option<usize>, greeter: nix::unistd::Pid) {
+/// GDM-style hand-off over `/run/user/<uid>/greetd-handoff.sock`, one request line per connection. The incoming
+/// compositor sends `switch` once it holds the DRM device (inactive session) and greetd activates `vt`: logind then
+/// pauses the outgoing session's devices and resumes the incoming ones in one step, so the kernel never gets a moment
+/// without a DRM master to restore its console. After its first frame the compositor sends `ready` and `outgoing`
+/// gets SIGTERM. A connection that closes without a line is `ready` from a compositor that predates `switch`.
+/// Without `switch` greetd switches after 3 s; without `ready` the alarm fallback retires `outgoing` after 10 s.
+/// With `logout`, the socket stays for the whole session: its `logout` request starts the logout hand-off.
+fn retire_on_ready(
+    user: &str,
+    vt: Option<usize>,
+    outgoing: nix::unistd::Pid,
+    logout: Option<mpsc::UnboundedSender<()>>,
+) {
     let Ok(Some(account)) = nix::unistd::User::from_name(user) else {
         if let Some(vt) = vt {
             tokio::task::spawn_local(activate_vt(vt));
@@ -558,35 +622,47 @@ fn retire_on_ready(user: &str, vt: Option<usize>, greeter: nix::unistd::Pid) {
     }
     tokio::task::spawn_local(async move {
         use tokio::io::AsyncBufReadExt;
-        use tokio::time::{timeout_at, Instant};
+        use tokio::time::{timeout, timeout_at, Instant};
         let start = Instant::now();
-        let deadline = start + Duration::from_secs(10);
+        let switch_deadline = start + Duration::from_secs(3);
+        let ready_deadline = start + Duration::from_secs(10);
         let mut pending_vt = vt;
+        let mut retired = false;
         'accept: loop {
-            let until = if pending_vt.is_some() { start + Duration::from_secs(3) } else { deadline };
-            let stream = match timeout_at(until, listener.accept()).await {
+            let until = match (pending_vt.is_some(), retired) {
+                (true, _) => Some(switch_deadline),
+                (false, false) => Some(ready_deadline),
+                (false, true) if logout.is_some() => None,
+                _ => break,
+            };
+            let accepted = match until {
+                Some(until) => timeout_at(until, listener.accept()).await,
+                None => Ok(listener.accept().await),
+            };
+            let stream = match accepted {
                 Ok(Ok((stream, _))) => stream,
                 Ok(Err(e)) => {
                     eprintln!("hand-off: accept failed: {e}");
                     break;
                 }
-                Err(_) => match pending_vt.take() {
-                    Some(vt) => {
+                Err(_) => {
+                    if let Some(vt) = pending_vt.take() {
                         eprintln!("hand-off: no switch request in 3 s, switching to VT {vt}");
                         activate_vt(vt).await;
-                        continue;
+                    } else {
+                        // The alarm fallback retires the outgoing session.
+                        retired = true;
                     }
-                    None => break,
-                },
+                    continue;
+                }
             };
             let mut lines = tokio::io::BufReader::new(stream).lines();
             let mut got_line = false;
             loop {
-                let line = match timeout_at(deadline, lines.next_line()).await {
+                let line = match timeout(Duration::from_secs(5), lines.next_line()).await {
                     Ok(Ok(Some(line))) => line,
-                    Ok(_) if got_line => continue 'accept,
-                    Ok(_) => "ready".to_string(),
-                    Err(_) => break 'accept,
+                    Ok(_) if !got_line => "ready".to_string(),
+                    _ => continue 'accept,
                 };
                 got_line = true;
                 match line.trim() {
@@ -599,10 +675,18 @@ fn retire_on_ready(user: &str, vt: Option<usize>, greeter: nix::unistd::Pid) {
                         if let Some(vt) = pending_vt.take() {
                             activate_vt(vt).await;
                         }
-                        let _ = nix::sys::signal::kill(greeter, nix::sys::signal::Signal::SIGTERM);
-                        break 'accept;
+                        if !retired {
+                            retired = true;
+                            let _ = nix::sys::signal::kill(outgoing, nix::sys::signal::Signal::SIGTERM);
+                        }
+                    }
+                    "logout" if retired => {
+                        if let Some(logout) = &logout {
+                            let _ = logout.send(());
+                            break 'accept;
+                        }
                     }
-                    other => eprintln!("hand-off: unknown request {other:?}"),
+                    other => eprintln!("hand-off: unexpected request {other:?}"),
                 }
             }
         }
