+    /// Resolves when a user session's compositor asks to log out.
+    pub async fn logout_requested(&self) {
+        let _ = self.logout_rx.lock().await.recv().await;
+    }
+
+    /// Logout hand-off, L6 in reverse: the greeter starts on its VT in the background while the user's compositor
+    /// keeps its frame and DRM master; the greeter's compositor asks for the VT switch once it holds the DRM device,
+    /// and its first frame retires the user session (the user's compositor also exits on its own once inactive).
+    pub async fn logout(&self) -> Result<(), Error> {
+        let mut inner = self.inner.write().await;
+        if inner.outgoing.is_some() || !inner.current.as_ref().is_some_and(|c| !c.is_greeter) {
+            return Ok(());
+        }
+        let TerminalMode::Terminal { path, vt, graphics, .. } = &self.term_mode else {
+            return Ok(());
+        };
+        let background = TerminalMode::Terminal {
+            path: path.clone(),
+            vt: *vt,
+            switch: false,
+            graphics: *graphics,
+        };
+        let stamp = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_secs())
+            .unwrap_or_default();
+        // The greeter's compositor holds the user's last frame until its own wallpaper maps (held_frame.cpp).
+        let greeter = self
+            .start_greeter_on(&background, vec![format!("ANDROMEDA_LOGIN_HANDOFF={stamp}")])
+            .await?;
+        let Some(mut user) = inner.current.replace(SessionChildSet {
+            child: greeter,
+            time: Instant::now(),
+            is_greeter: true,
+        }) else {
+            return Ok(());
+        };
+        user.time = Instant::now();
+        retire_on_ready(&self.greeter_user, Some(*vt), user.child.sub_task, None);
+        inner.outgoing = Some(user);
+        alarm::set(1);
+        Ok(())
+    }
+
     /// Directly start a greeter session, bypassing the normal scheduling.
     pub async fn greet(&self) -> Result<(), Error> {
