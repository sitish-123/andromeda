diff --git a/greetd/src/context.rs b/greetd/src/context.rs
index 91638b0..7d9a53a 100644
--- a/greetd/src/context.rs
+++ b/greetd/src/context.rs
@@ -17,6 +17,7 @@ use crate::{
         interface::{Session, SessionChild, SessionState},
         worker::{AuthMessageType as SessAuthMessageType, SessionClass, TerminalMode},
     },
+    terminal::Terminal,
 };
 use greetd_ipc::AuthMessageType;
 
@@ -35,6 +36,8 @@ struct ContextInner {
     current: Option<SessionChildSet>,
     scheduled: Option<SessionSet>,
     configuring: Option<SessionSet>,
+    /// Hand-off: the greeter that stays alive after the user session took its own VT, until it exits.
+    outgoing: Option<SessionChildSet>,
 }
 
 /// Context keeps track of running sessions and start new ones.
@@ -48,6 +51,7 @@ pub struct Context {
     source_profile: bool,
     runfile: String,
     listener_path: String,
+    handoff: bool,
 }
 
 impl Context {
@@ -61,12 +65,14 @@ impl Context {
         source_profile: bool,
         runfile: String,
         listener_path: String,
+        handoff: bool,
     ) -> Context {
         Context {
             inner: RwLock::new(ContextInner {
                 current: None,
                 scheduled: None,
                 configuring: None,
+                outgoing: None,
             }),
             greeter_bin,
             greeter_user,
@@ -76,6 +82,26 @@ impl Context {
             source_profile,
             runfile,
             listener_path,
+            handoff,
+        }
+    }
+
+    /// The terminal of a user session. With hand-off, a free VT in graphics mode, so the greeter keeps its VT and
+    /// its frame on screen until the session's compositor takes over.
+    fn user_term_mode(&self) -> Result<TerminalMode, Error> {
+        match (&self.term_mode, self.handoff) {
+            (TerminalMode::Terminal { .. }, true) => {
+                let vt = Terminal::open("/dev/tty0")
+                    .and_then(|t| t.vt_get_next())
+                    .map_err(|e| format!("unable to get a free VT: {e}"))?;
+                Ok(TerminalMode::Terminal {
+                    path: format!("/dev/tty{vt}"),
+                    vt,
+                    switch: true,
+                    graphics: true,
+                })
+            }
+            _ => Ok(self.term_mode.clone()),
         }
     }
 
@@ -207,7 +233,7 @@ impl Context {
                 SessionClass::User,
                 &username,
                 true,
-                &self.term_mode,
+                &self.user_term_mode()?,
                 self.source_profile,
                 &self.listener_path,
             )
@@ -282,6 +308,25 @@ impl Context {
                     // Send our arguments to the session.
                     s.session.send_args(cmd, env).await?;
 
+                    if self.handoff {
+                        // The worker returns once the session's VT is in front: the greeter has lost the display
+                        // with its last frame still on the planes (wlroots closes framebuffers with CLOSEFB), and
+                        // the new compositor holds that frame until its own first frame.
+                        let child = s.session.start().await?;
+                        let mut inner = self.inner.write().await;
+                        let greeter = inner.current.replace(SessionChildSet {
+                            child,
+                            time: Instant::now(),
+                            is_greeter: false,
+                        });
+                        if let Some(mut g) = greeter {
+                            g.time = Instant::now();
+                            inner.outgoing = Some(g);
+                            alarm::set(2);
+                        }
+                        return Ok(());
+                    }
+
                     let mut inner = self.inner.write().await;
                     std::mem::swap(&mut session, &mut inner.scheduled);
                     drop(inner);
@@ -309,6 +354,15 @@ impl Context {
         // Keep trying to terminate the greeter until it gives up.
         let mut inner = self.inner.write().await;
 
+        if let Some(g) = &inner.outgoing {
+            if g.time.elapsed() > Duration::from_secs(10) {
+                g.child.kill();
+            } else {
+                g.child.term();
+            }
+            alarm::set(1);
+        }
+
         if let Some(mut p) = inner.scheduled.take() {
             if let Some(g) = inner.current.take() {
                 if p.time.elapsed() > Duration::from_secs(10) {
@@ -350,6 +404,10 @@ impl Context {
                 // We got an exit, see if it's something we need to clean up.
                 Ok(WaitStatus::Exited(pid, ..)) | Ok(WaitStatus::Signaled(pid, ..)) => {
                     let mut inner = self.inner.write().await;
+                    if inner.outgoing.as_ref().is_some_and(|g| g.child.owns_pid(pid)) {
+                        inner.outgoing = None;
+                        continue;
+                    }
                     let (was_greeter, sesion_length) = match &inner.current {
                         Some(s) if s.child.owns_pid(pid) => {
                             let res = (s.is_greeter, s.time.elapsed());
@@ -419,6 +477,9 @@ impl Context {
         if let Some(sess) = inner.current.take() {
             sess.child.term();
         }
+        if let Some(sess) = inner.outgoing.take() {
+            sess.child.term();
+        }
         Ok(())
     }
 }
