#!/bin/sh
# Runs as root through pkexec (org.andromeda.power.configure). Accepts only whitelisted keys and values.
# Usage: andromeda-power-config <key> <value>
#   lid-battery|lid-power|lid-docked  suspend|hibernate|suspend-then-hibernate|lock|ignore
#   power-key                         same, plus poweroff
#   hibernate-delay                   off|30min|1h|2h|3h
#   swapfile                          <GiB> 1-299 (ext4, xfs, f2fs only)
#   sleep-mode                        default|s2idle|deep (only a mode the kernel lists in /sys/power/mem_sleep)
set -eu
PATH=/usr/bin
[ $# -eq 2 ] || { echo "usage: $0 <key> <value>" >&2; exit 2; }
key=$1 value=$2
# ANDROMEDA_POWER_ETC is a test root; root always writes /etc.
[ "$(id -u)" -ne 0 ] || ANDROMEDA_POWER_ETC=
logind_dir=${ANDROMEDA_POWER_ETC:-/etc}/systemd/logind.conf.d
sleep_dir=${ANDROMEDA_POWER_ETC:-/etc}/systemd/sleep.conf.d

# Commands that change the running system; the test root only prints them.
sys() { if [ -n "${ANDROMEDA_POWER_ETC:-}" ]; then echo "would run: $*"; else "$@"; fi; }

# swapfile <GiB>: grow or make the disk swap file for hibernation (mkswap(8) --size --file). The new file is made
# beside the old one first, so a failure leaves the old swap in place.
if [ "$key" = swapfile ]; then
  case $value in [1-9] | [1-9][0-9] | [1-2][0-9][0-9]) ;; *) echo "bad size: $value" >&2; exit 2 ;; esac
  path=$(awk '$2 == "file" && $1 !~ /^\/dev\/zram/ { print $1; exit }' /proc/swaps)
  [ -n "$path" ] || path=/swapfile
  path=${ANDROMEDA_POWER_ETC:-}$path
  fs=$(findmnt -no FSTYPE -T "$(dirname "$path")")
  case $fs in
    ext4 | xfs | f2fs) ;;
    *) echo "not supported on $fs" >&2; exit 3 ;;
  esac
  old_kib=0
  [ -f "$path" ] && old_kib=$(($(stat -c %s "$path") / 1024))
  avail_kib=$(df -k --output=avail "$(dirname "$path")" | tail -n 1)
  [ "$avail_kib" -gt $((value * 1048576 + 1048576)) ] || { echo "not enough free disk space" >&2; exit 4; }
  if grep -q "^$path " /proc/swaps; then
    used_kib=$(awk -v p="$path" '$1 == p { print $4 }' /proc/swaps)
    free_kib=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo)
    [ "$used_kib" -lt "$free_kib" ] || { echo "not enough free memory to turn the old swap off" >&2; exit 4; }
  fi
  new=$path.new
  rm -f "$new"
  mkswap --size "${value}G" --file "$new" >/dev/null
  if grep -q "^$path " /proc/swaps; then sys swapoff "$path"; fi
  mv "$new" "$path"
  sys swapon "$path"
  if ! grep -qs "^${path#"${ANDROMEDA_POWER_ETC:-}"}[[:space:]]" "${ANDROMEDA_POWER_ETC:-}/etc/fstab"; then
    unit=$(systemd-escape -p --suffix=swap "${path#"${ANDROMEDA_POWER_ETC:-}"}")
    mkdir -p "${ANDROMEDA_POWER_ETC:-}/etc/systemd/system"
    printf '[Swap]\nWhat=%s\n\n[Install]\nWantedBy=swap.target\n' "${path#"${ANDROMEDA_POWER_ETC:-}"}" \
      >"${ANDROMEDA_POWER_ETC:-}/etc/systemd/system/$unit"
    sys systemctl daemon-reload
    sys systemctl enable "$unit"
  fi
  echo "swap file $path: $((old_kib / 1048576)) GiB -> $value GiB"
  exit 0
fi

case $key in
  lid-battery) section=Login dir=$logind_dir name=HandleLidSwitch ;;
  lid-power) section=Login dir=$logind_dir name=HandleLidSwitchExternalPower ;;
  lid-docked) section=Login dir=$logind_dir name=HandleLidSwitchDocked ;;
  power-key) section=Login dir=$logind_dir name=HandlePowerKey ;;
  hibernate-delay) section=Sleep dir=$sleep_dir name=HibernateDelaySec ;;
  sleep-mode) section=Sleep dir=$sleep_dir name=MemorySleepMode ;;
  *) echo "unknown key: $key" >&2; exit 2 ;;
esac

case $key:$value in
  lid-*:suspend | lid-*:hibernate | lid-*:suspend-then-hibernate | lid-*:lock | lid-*:ignore) ;;
  power-key:suspend | power-key:hibernate | power-key:suspend-then-hibernate | power-key:lock | power-key:ignore) ;;
  power-key:poweroff) ;;
  hibernate-delay:off | hibernate-delay:30min | hibernate-delay:1h | hibernate-delay:2h | hibernate-delay:3h) ;;
  sleep-mode:default) value=off ;;
  sleep-mode:s2idle | sleep-mode:deep)
    grep -qw "$value" /sys/power/mem_sleep || { echo "kernel does not offer $value" >&2; exit 2; } ;;
  *) echo "bad value for $key: $value" >&2; exit 2 ;;
esac

file=$dir/60-andromeda.conf
mkdir -p "$dir"
tmp=$(mktemp "$dir/.60-andromeda.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  echo "# Written by Settings › Power (andromeda-power-config)."
  echo "[$section]"
  [ -f "$file" ] && grep -E '^[A-Za-z]+=' "$file" | grep -v "^$name=" || true
  [ "$value" = off ] || echo "$name=$value"
} >"$tmp"
chmod 644 "$tmp"
mv "$tmp" "$file"
trap - EXIT

# logind rereads its drop-ins on SIGHUP; sleep.conf is read at each sleep.
if [ "$section" = Login ] && [ -z "${ANDROMEDA_POWER_ETC:-}" ]; then
  systemctl kill -s HUP systemd-logind.service
fi
