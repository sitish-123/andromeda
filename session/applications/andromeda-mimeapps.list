# Andromeda's own apps open folders, images (Photos = the Files Gallery), PDFs, audio and video in an Andromeda session (XDG_CURRENT_DESKTOP=andromeda).
# The user's ~/.config/mimeapps.list wins over it.
[Default Applications]
inode/directory=dev.andromeda.Files.desktop
application/pdf=dev.andromeda.Viewer.desktop
image/png=dev.andromeda.Photos.desktop
image/jpeg=dev.andromeda.Photos.desktop
image/webp=dev.andromeda.Photos.desktop
image/gif=dev.andromeda.Photos.desktop
image/avif=dev.andromeda.Photos.desktop
image/heif=dev.andromeda.Photos.desktop
image/jxl=dev.andromeda.Photos.desktop
image/tiff=dev.andromeda.Photos.desktop
image/bmp=dev.andromeda.Photos.desktop
image/svg+xml=dev.andromeda.Photos.desktop
audio/mpeg=dev.andromeda.Player.desktop
audio/mp4=dev.andromeda.Player.desktop
audio/aac=dev.andromeda.Player.desktop
audio/flac=dev.andromeda.Player.desktop
audio/x-flac=dev.andromeda.Player.desktop
audio/ogg=dev.andromeda.Player.desktop
audio/opus=dev.andromeda.Player.desktop
audio/x-vorbis+ogg=dev.andromeda.Player.desktop
audio/x-opus+ogg=dev.andromeda.Player.desktop
audio/wav=dev.andromeda.Player.desktop
audio/x-wav=dev.andromeda.Player.desktop
audio/webm=dev.andromeda.Player.desktop
audio/x-matroska=dev.andromeda.Player.desktop
audio/x-m4a=dev.andromeda.Player.desktop
audio/x-ape=dev.andromeda.Player.desktop
audio/x-wavpack=dev.andromeda.Player.desktop
video/mp4=dev.andromeda.Player.desktop
video/x-matroska=dev.andromeda.Player.desktop
video/webm=dev.andromeda.Player.desktop
video/quicktime=dev.andromeda.Player.desktop
video/x-msvideo=dev.andromeda.Player.desktop
video/mpeg=dev.andromeda.Player.desktop
video/ogg=dev.andromeda.Player.desktop
video/x-flv=dev.andromeda.Player.desktop
video/3gpp=dev.andromeda.Player.desktop
video/mp2t=dev.andromeda.Player.desktop
video/x-ms-wmv=dev.andromeda.Player.desktop
audio/x-mpegurl=dev.andromeda.Player.desktop
audio/mpegurl=dev.andromeda.Player.desktop
