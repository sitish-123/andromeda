# i915 and xe grant a high-priority GPU context only with CAP_SYS_NICE (KWin does the same). Without it, the
# compositor's frames queue behind client GPU work: glass-off p99 9.4 -> 6.0 ms on an HD 520.
post_install() {
  setcap cap_sys_nice=ep usr/bin/andromeda || echo ':: could not set cap_sys_nice on /usr/bin/andromeda: frames may queue behind apps on the GPU'
}

post_upgrade() {
  post_install
}
