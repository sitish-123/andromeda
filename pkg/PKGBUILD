pkgbase=desktop-git
pkgname=(andromeda andromeda-compositor-git noctalia-desktop-git xdg-desktop-portal-andromeda-git andromeda-link-git
  andromeda-power-git noctalia-greeter-desktop-git)
# Epoch keeps the monorepo revision newer than the per-fork versions it replaces.
epoch=1
pkgver=r0
pkgrel=1
arch=(x86_64)
license=(MIT)
# Arch's default makepkg.conf adds a debug package of every binary's symbols, several times the desktop's size.
options=(!debug)
makedepends=(git meson ninja wayland-protocols nlohmann-json stb
  wlroots0.20 wayland libinput libxkbcommon libdrm pixman mesa cairo pango lcms2 jemalloc tomlplusplus
  curl fontconfig freetype2 glib2 harfbuzz libglvnd libical libjxl libpipewire libqalculate librsvg libsecret
  libsndfile libsodium libwebp libwireplumber libxml2 md4c pam polkit qrencode sdbus-cpp xdg-desktop-portal gtk4 cargo protobuf
  gstreamer gst-plugins-base-libs qt6-base qt6-declarative qt6-multimedia)
url=https://github.com/sitish-123/andromeda
# `just package` and the release workflow build a local checkout; anyone else builds the published repository.
source=("desktop::git+${ANDROMEDA_SOURCE:-$url.git}")
sha256sums=(SKIP)

pkgver() {
  cd desktop
  printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  git -C desktop submodule update --init link
  cargo fetch --locked --manifest-path desktop/link/Cargo.toml
}

build() {
  arch-meson desktop/compositor build-compositor -Dcpp_std=c++23 -Dtests=disabled -Db_lto=true
  arch-meson desktop/shell build-shell -Dcpp_std=c++23 -Dtests=disabled -Db_lto=true
  arch-meson desktop/portal build-portal -Dcpp_std=c++23
  arch-meson desktop/greeter build-greeter -Dcpp_std=c++23 -Db_lto=true
  meson compile -C build-compositor
  meson compile -C build-shell
  meson compile -C build-portal
  meson compile -C build-greeter
  # makepkg's -flto=auto turns ring's C and cxx-qt's C++ objects into GCC LTO bitcode, which the Rust linker cannot read.
  CFLAGS="${CFLAGS//-flto=auto/}" CXXFLAGS="${CXXFLAGS//-flto=auto/}" cargo build --frozen --release --manifest-path desktop/link/Cargo.toml -p link-daemon \
    -p link-mount -p link-mirror -p link-desk -p link-session
}

package_andromeda() {
  pkgdesc='Andromeda desktop: the Andromeda compositor, Noctalia shell, portal, and Link phone continuity'
  # Everything the desktop offers works out of the box; the power policy changes kernel defaults, so it stays opt-in.
  depends=(andromeda-compositor-git noctalia-desktop-git xdg-desktop-portal-andromeda-git andromeda-link-git
    noctalia-greeter-desktop-git scrcpy android-tools gst-plugin-va gst-libav libpulse pipewire-pulse)
  optdepends=('andromeda-power-git: laptop power saving (PCIe ASPM, runtime PM, USB autosuspend); can upset some devices')
  install -Dm755 desktop/session/audio-park/andromeda-audio-park "$pkgdir/usr/bin/andromeda-audio-park"
  install -Dm644 desktop/session/audio-park/andromeda-audio-park.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-audio-park.service"
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../andromeda-audio-park.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-audio-park.service"
}

package_andromeda-compositor-git() {
  pkgdesc='Andromeda Wayland compositor'
  depends=(wlroots0.20 wayland libinput libxkbcommon libdrm pixman mesa cairo pango lcms2 jemalloc tomlplusplus
    xwayland-satellite)
  provides=(andromeda-compositor)
  conflicts=(andromeda-compositor umbriel umbriel-desktop-git)
  replaces=(umbriel-desktop-git)
  meson install -C build-compositor --destdir "$pkgdir"
  install -Dm644 desktop/session/background.slice.d/andromeda-lp-e-cores.conf \
    "$pkgdir/usr/lib/systemd/user/background.slice.d/andromeda-lp-e-cores.conf"
  install -Dm644 desktop/compositor/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_noctalia-desktop-git() {
  pkgdesc='Noctalia desktop shell, desktop fork'
  depends=(bash cairo curl fontconfig freetype2 git glib2 glibc harfbuzz hicolor-icon-theme jemalloc libgcc libglvnd
    libical libjxl libpipewire libqalculate librsvg libsecret libsndfile libsodium libstdc++ libwebp libwireplumber
    libxkbcommon libxml2 md4c pam polkit pango qrencode sdbus-cpp tomlplusplus wayland
    gstreamer gst-plugins-base gst-plugins-good gst-plugins-bad gst-plugin-pipewire gst-plugin-va)
  optdepends=('ddcutil: monitor brightness control')
  provides=(noctalia)
  conflicts=(noctalia)
  meson install -C build-shell --destdir "$pkgdir"
  install -Dm644 desktop/session/noctalia.service "$pkgdir/usr/lib/systemd/user/noctalia.service"
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../noctalia.service "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/noctalia.service"
  install -Dm644 desktop/shell/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_xdg-desktop-portal-andromeda-git() {
  pkgdesc='xdg-desktop-portal backend for Andromeda (ScreenCast, Screenshot)'
  depends=(xdg-desktop-portal sdbus-cpp libpipewire wayland libdrm mesa cairo tomlplusplus gtk4)
  provides=(xdg-desktop-portal-andromeda xdg-desktop-portal-impl)
  conflicts=(xdg-desktop-portal-andromeda xdg-desktop-portal-umbriel-git)
  replaces=(xdg-desktop-portal-umbriel-git)
  meson install -C build-portal --destdir "$pkgdir"
  install -Dm644 desktop/portal/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_andromeda-link-git() {
  pkgdesc='Andromeda Link daemon: phone and desktop continuity'
  depends=(glibc gcc-libs dbus fuse3 gtk4 qt6-base qt6-declarative qt6-multimedia gstreamer gst-plugins-base-libs
    gst-plugins-bad gst-plugin-gtk4)
  optdepends=('bluez: Link over Bluetooth when no Wi-Fi reaches the phone'
    'networkmanager: joining the phone'"'"'s hotspot or Wi-Fi Direct group for large transfers away from Wi-Fi'
    'gst-plugin-va: hardware decoding of the mirrored phone screen'
    'gst-libav: software decoding of the mirrored phone screen without VA-API'
    'scrcpy: phone apps in their own windows (andromeda-link-apps)'
    'android-tools: adb for andromeda-link-apps')
  conflicts=(umbriel-link-git)
  replaces=(umbriel-link-git)
  backup=(etc/ufw/applications.d/andromeda-link)
  install=andromeda-link.install
  install -Dm755 desktop/link/target/release/andromeda-linkd "$pkgdir/usr/bin/andromeda-linkd"
  install -Dm644 desktop/link/dist/andromeda-linkd.service "$pkgdir/usr/lib/systemd/user/andromeda-linkd.service"
  install -d "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants"
  ln -s ../andromeda-linkd.service "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-linkd.service"
  install -Dm755 desktop/link/target/release/andromeda-link-mount "$pkgdir/usr/bin/andromeda-link-mount"
  install -Dm755 desktop/link/target/release/andromeda-link-mirror "$pkgdir/usr/bin/andromeda-link-mirror"
  install -Dm755 desktop/link/target/release/andromeda-link-apps "$pkgdir/usr/bin/andromeda-link-apps"
  install -Dm644 desktop/link/dist/andromeda-link-mount.service "$pkgdir/usr/lib/systemd/user/andromeda-link-mount.service"
  ln -s ../andromeda-link-mount.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-session.target.wants/andromeda-link-mount.service"
  install -Dm755 desktop/link/target/release/andromeda-link-session "$pkgdir/usr/bin/andromeda-link-session"
  install -Dm644 desktop/link/dist/andromeda-link-session.service \
    "$pkgdir/usr/lib/systemd/user/andromeda-link-session.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../andromeda-link-session.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/andromeda-link-session.service"
  install -Dm644 desktop/link/dist/org.andromeda.Link1.service "$pkgdir/usr/share/dbus-1/services/org.andromeda.Link1.service"
  install -Dm644 desktop/link/api/org.andromeda.Link1.xml "$pkgdir/usr/share/dbus-1/interfaces/org.andromeda.Link1.xml"
  install -Dm644 desktop/link/dist/andromeda-link.ufw "$pkgdir/etc/ufw/applications.d/andromeda-link"
  install -Dm644 desktop/link/dist/60-andromeda-link-bluetooth.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/60-andromeda-link-bluetooth.conf"
  install -Dm755 desktop/link/target/release/andromeda-link "$pkgdir/usr/bin/andromeda-link"
  install -Dm644 desktop/link/dist/org.andromeda.Link.desktop "$pkgdir/usr/share/applications/org.andromeda.Link.desktop"
  install -Dm644 desktop/link/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_andromeda-power-git() {
  pkgdesc='Andromeda static kernel power policy: PCIe ASPM, runtime PM, USB autosuspend, HDA power save'
  depends=(systemd)
  conflicts=(umbriel-power-git)
  replaces=(umbriel-power-git)
  install -Dm644 desktop/session/power/andromeda-power.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/andromeda-power.conf"
  install -Dm644 desktop/session/power/60-andromeda-power.rules "$pkgdir/usr/lib/udev/rules.d/60-andromeda-power.rules"
  install -Dm644 desktop/session/power/andromeda-power.modprobe "$pkgdir/usr/lib/modprobe.d/andromeda-power.conf"
}

package_noctalia-greeter-desktop-git() {
  pkgdesc='Noctalia greeter fork for greetd: the Ryoku login, face first through Gaze, the password always open'
  depends=(greetd wlroots0.20 libinput libxkbcommon cairo pango librsvg libxml2 glib2 fontconfig freetype2)
  optdepends=('gaze-bin: face login; needs the marker-host change until it is upstream (tools/gaze-patched.sh)')
  provides=(noctalia-greeter)
  conflicts=(noctalia-greeter)
  meson install -C build-greeter --destdir "$pkgdir"
  install -Dm644 desktop/session/pam.d/gdm-face "$pkgdir/etc/pam.d/gdm-face"
  # greetd owns /etc/greetd/config.toml; tools/greeter-switch.sh puts this one in place.
  install -Dm644 desktop/session/greetd/config.toml "$pkgdir/usr/share/noctalia-greeter/greetd.toml"
  install -Dm644 desktop/greeter/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 desktop/greeter/assets/fonts/outfit-license.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-Outfit.txt"
}
