[Desktop Entry]
Type=Application
Name=Player
Comment=Play music and videos
Exec=andromeda-player %U
Icon=dev.andromeda.Player
Terminal=false
Categories=AudioVideo;Audio;Video;Player;
Keywords=music;video;movie;song;album;playlist;mpv;
MimeType=audio/mpeg;audio/mp4;audio/aac;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/webm;audio/x-matroska;audio/x-m4a;audio/x-ape;audio/x-wavpack;audio/x-mpegurl;audio/mpegurl;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/ogg;video/x-flv;video/3gpp;video/mp2t;video/x-ms-wmv;
StartupWMClass=dev.andromeda.Player
